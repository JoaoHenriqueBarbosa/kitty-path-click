+    # path-click {{{
+    def resolve_detected_path(self, text: str) -> tuple[str, str] | None | bool:
+        """For text matched by detect_url_regex: False if it does not look like a file
+        path, None if it does but no such path exists, else (absolute path, fragment).
+        Paths may be absolute, ~/ or relative to the foreground program's directory,
+        with an optional :line[:col] suffix that becomes the fragment L<line>[:<col>]."""
+        import re
+        m = re.fullmatch(r'(.+?)(?::(\d+)(?::(\d+))?)?', text.strip())
+        if m is None:
+            return False
+        raw, line, col = m.group(1), m.group(2), m.group(3)
+        if '://' in raw or re.match(r'[a-zA-Z][a-zA-Z0-9+.-]*:', raw) or re.search(r'\s', raw):
+            return False
+        if not (raw.startswith('~') or '/' in raw or '.' in raw):
+            return False
+        if raw.startswith('~'):
+            raw = os.path.expanduser(raw)
+        if not os.path.isabs(raw):
+            cwd = self.get_cwd_of_child() or self.get_cwd_of_child(oldest=True) or self.child.cwd or ''
+            raw = os.path.join(cwd, raw)
+        path = os.path.normpath(raw)
+        if not os.path.exists(path):
+            return None
+        if os.path.isdir(path):
+            path += '/'
+        return path, (f'L{line}' + (f':{col}' if col else '')) if line else ''
+
+    def accept_detected_url(self, text: str) -> bool:
+        "Called on mouse hover for every detect_url_regex match: reject paths that do not exist"
+        # Hovering asks about the same few candidates on every mouse move
+        cache: dict[str, tuple[float, bool]] = self.__dict__.setdefault('_detected_path_cache', {})
+        now = monotonic()
+        cached = cache.get(text)
+        if cached is not None and now - cached[0] < 1.0:
+            return cached[1]
+        ans = self.resolve_detected_path(text) is not None
+        if len(cache) > 64:
+            cache.clear()
+        cache[text] = now, ans
+        return ans
+    # }}}
+
     def open_url(self, url: str, hyperlink_id: int, cwd: str | None = None) -> None:
