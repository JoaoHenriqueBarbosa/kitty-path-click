+// path-click: let the window veto a regex match, so that text that looks like a
+// file path is only highlighted and clickable when the path actually exists
+static bool
+regex_match_is_accepted(Screen *self, const char *text, size_t len) {
+    if (self->callbacks == Py_None) return true;
+    PyObject *ret = PyObject_CallMethod(self->callbacks, "accept_detected_url", "s#", text, (Py_ssize_t)len);
+    if (ret == NULL) { PyErr_Clear(); return true; }
+    const bool ok = PyObject_IsTrue(ret) == 1;
+    Py_DECREF(ret);
+    return ok;
+}
